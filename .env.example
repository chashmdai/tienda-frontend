# Copiar a .env y completar. NO commitear .env.

# En producción: IP privada de la EC2 que ejecuta el backend.
# En local con docker compose: 'backend' (nombre del servicio).
BACKEND_HOST=backend
BACKEND_PORT=3001

# Solo para el docker-compose local de prueba e2e:
DB_USER=alumno
DB_PASSWORD=cambiar-esto
DB_NAME=tienda_perritos
MYSQL_ROOT_PASSWORD=cambiar-esto-root
